{
 "uid": "dragonwilds",
 "title": "Dragonwilds server",
 "tags": [
  "dragonwilds"
 ],
 "timezone": "browser",
 "refresh": "30s",
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Server",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Server up",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "refId": "A",
     "expr": "dragonwilds_up{server=\"Dragonwilds\"}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN",
         "color": "red"
        },
        "1": {
         "text": "UP",
         "color": "green"
        }
       }
      }
     ],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "noValue": "DOWN"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Players online",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "refId": "A",
     "expr": "dragonwilds_players_online{server=\"Dragonwilds\"}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "noValue": "0",
     "decimals": 0,
     "max": 6
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "description": "Joins are verified from real logs. Leave detection is not verified yet (see metrics/README.md in the repo); the count may stay up after a player leaves until the server restarts."
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Version",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "refId": "A",
     "expr": "dragonwilds_build_info{server=\"Dragonwilds\"}",
     "legendFormat": "{{version}}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "graphMode": "none",
    "textMode": "name",
    "colorMode": "none"
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Uptime",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "refId": "A",
     "expr": "time() - dragonwilds_start_timestamp_seconds{server=\"Dragonwilds\"} and on() dragonwilds_up{server=\"Dragonwilds\"} == 1",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "noValue": "down"
    },
    "overrides": []
   },
   "options": {
    "graphMode": "none",
    "colorMode": "none"
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Last save (.sav age)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "refId": "A",
     "expr": "dragonwilds_save_age_seconds{server=\"Dragonwilds\"}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 900
       },
       {
        "color": "red",
        "value": 3600
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 7,
   "type": "stat",
   "title": "Log last written",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 20,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "refId": "A",
     "expr": "dragonwilds_log_age_seconds{server=\"Dragonwilds\"}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 150
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Players online over time",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 16,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "refId": "A",
     "expr": "dragonwilds_players_online{server=\"Dragonwilds\"}",
     "legendFormat": "players"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "min": 0,
     "decimals": 0,
     "custom": {
      "drawStyle": "line",
      "lineInterpolation": "stepAfter",
      "fillOpacity": 20
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "description": "Joins are verified from real logs. Leave detection is not verified yet (see metrics/README.md in the repo); the count may stay up after a player leaves until the server restarts."
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Joins / leaves (per hour)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 5,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "refId": "A",
     "expr": "increase(dragonwilds_joins_total{server=\"Dragonwilds\"}[1h])",
     "legendFormat": "joins"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "refId": "B",
     "expr": "increase(dragonwilds_leaves_total{server=\"Dragonwilds\"}[1h])",
     "legendFormat": "leaves"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "min": 0,
     "decimals": 0,
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 10,
   "type": "row",
   "title": "Container (cAdvisor)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "CPU (% of one core; limit 400%)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "refId": "A",
     "expr": "100 * sum(rate(container_cpu_usage_seconds_total{server=\"Dragonwilds\"}[2m]))",
     "legendFormat": "cpu"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Memory",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 13,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "refId": "A",
     "expr": "container_memory_working_set_bytes{server=\"Dragonwilds\"}",
     "legendFormat": "working set"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "refId": "B",
     "expr": "container_spec_memory_limit_bytes{server=\"Dragonwilds\"}",
     "legendFormat": "limit"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Network",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 13,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "refId": "A",
     "expr": "sum(rate(container_network_receive_bytes_total{server=\"Dragonwilds\",interface=\"eth0\"}[2m]))",
     "legendFormat": "rx"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "refId": "B",
     "expr": "-sum(rate(container_network_transmit_bytes_total{server=\"Dragonwilds\",interface=\"eth0\"}[2m]))",
     "legendFormat": "tx"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Bps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
